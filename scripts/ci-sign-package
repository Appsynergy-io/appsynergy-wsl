#!/usr/bin/env python3
"""Separate signing job: production on trusted main, ephemeral keys elsewhere."""
import argparse
import os
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from wslbuild.evidence import load_json, require
from wslbuild.inputs import ROOT

parser = argparse.ArgumentParser()
parser.add_argument("directory", type=Path)
parser.add_argument("--testing", action="store_true")
args = parser.parse_args()
trusted = os.environ.get("GITHUB_EVENT_NAME") == "push" and os.environ.get("GITHUB_REF") == "refs/heads/main"
require(args.testing != trusted, "production/test signing context mismatch")
with tempfile.TemporaryDirectory(prefix="wsl-signing-") as temp:
    os.chmod(temp, 0o700)
    gpg = ["gpg", "--no-options", "--homedir", temp, "--batch"]
    try:
        if args.testing:
            subprocess.run([*gpg, "--pinentry-mode", "loopback", "--passphrase", "", "--quick-generate-key",
                            "AppSynergy temporary CI test key", "ed25519", "sign", "1d"], check=True, timeout=60)
            listing = subprocess.check_output([*gpg, "--with-colons", "--list-keys"], text=True, timeout=15)
            fingerprint = next(line.split(":")[9] for line in listing.splitlines() if line.startswith("fpr:"))
            public = subprocess.check_output([*gpg, "--armor", "--export", fingerprint], timeout=15)
            (args.directory / "testing-key.asc").write_bytes(public)
        else:
            secret = os.environ.pop("WSL_PACKAGE_SIGNING_KEY", "")
            if not secret:
                print("Missing WSL_PACKAGE_SIGNING_KEY in the isolated package-signing environment", file=sys.stderr)
                raise SystemExit(2)
            subprocess.run([*gpg, "--import"], input=secret.encode(), check=True, timeout=30)
            fingerprint = load_json(ROOT / "sources/signing.lock.json")["integration_fingerprint"]
        packages = list(args.directory.glob("*.pkg.tar.zst"))
        require(len(packages) == 1 and not packages[0].is_symlink(), "one integration package required")
        subprocess.run([*gpg, "--local-user", fingerprint, "--detach-sign", str(packages[0])], check=True, timeout=60)
        subprocess.run([*gpg, "--verify", str(packages[0]) + ".sig", str(packages[0])], check=True, timeout=30)
    finally:
        subprocess.run(["gpgconf", "--homedir", temp, "--kill", "gpg-agent"], capture_output=True, timeout=15)
