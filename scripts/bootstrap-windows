#!/usr/bin/env python3
"""Install pinned Linux PowerShell/analyzer for analysis and pure behavior tests."""
import sys
import tarfile
import zipfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from wslbuild.evidence import load_json, require
from wslbuild.inputs import CACHE, ROOT, fetch

for name, entry in load_json(ROOT / "sources/windows-tools.lock.json").items():
    archive = fetch(entry["url"], entry["sha256"])
    output = CACHE / (name + "-" + entry["sha256"])
    output.mkdir(exist_ok=True)
    if name == "PowerShell":
        with tarfile.open(archive) as stream:
            require(sum(m.size for m in stream.getmembers()) < 512 * 1024**2, "PowerShell archive size")
            stream.extractall(output, filter="data")
        (output / "pwsh").chmod(0o755)
    else:
        with zipfile.ZipFile(archive) as stream:
            for member in stream.infolist():
                require(not Path(member.filename).is_absolute() and ".." not in Path(member.filename).parts,
                        "analyzer archive path")
            require(sum(m.file_size for m in stream.infolist()) < 512 * 1024**2, "analyzer archive size")
            stream.extractall(output)
    print(f"Verified {name} {entry['version']}")
    alias = CACHE / name
    require(not alias.exists() or alias.is_symlink(), "tool cache alias must be a symlink")
    if alias.is_symlink():
        alias.unlink()
    alias.symlink_to(output.name, target_is_directory=True)
