#!/usr/bin/env python3
"""Signing-only entry point. Never executes package contents or runs a build."""
import argparse
import os
import re
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from wslbuild.evidence import load_json, require
from wslbuild.inputs import ROOT

parser = argparse.ArgumentParser()
parser.add_argument("directory", type=Path)
parser.add_argument("--keyring", type=Path, required=True)
args = parser.parse_args()
if os.environ.get("GITHUB_ACTIONS") == "true":
    require(os.environ.get("GITHUB_EVENT_NAME") == "push" and os.environ.get("GITHUB_REF") == "refs/heads/main", "production signing requires trusted main")
fingerprint = load_json(ROOT / "sources/signing.lock.json")["integration_fingerprint"]
packages = list(args.directory.glob("*.pkg.tar.zst"))
require(len(packages) == 1 and not packages[0].is_symlink(), "one integration package required")
require(re.fullmatch(r"appsynergy-wsl-integration-\d+\.\d+\.\d+-\d+-any\.pkg\.tar\.zst", packages[0].name), "integration package identity")
subprocess.run(["gpg", "--no-options", "--homedir", str(args.keyring), "--batch", "--yes", "--local-user", fingerprint,
                "--detach-sign", str(packages[0])], check=True, timeout=60)
subprocess.run(["gpg", "--no-options", "--homedir", str(args.keyring), "--batch", "--verify",
                str(packages[0]) + ".sig", str(packages[0])], check=True, timeout=30)
