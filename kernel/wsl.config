# WSL adaptation of the pinned AppSynergy server configuration.
# Boot storage and Hyper-V transports must be built in, before module VHDX mount.
CONFIG_HYPERV=y
CONFIG_HYPERV_VMBUS=y
CONFIG_HYPERV_STORAGE=y
CONFIG_HYPERV_NET=y
CONFIG_HYPERV_UTILS=y
CONFIG_HYPERV_BALLOON=y
CONFIG_HYPERV_VSOCKETS=y
CONFIG_VSOCKETS=y
CONFIG_SCSI=y
CONFIG_SCSI_FC_ATTRS=y
CONFIG_CONNECTOR=y
CONFIG_PPS=y
CONFIG_PTP_1588_CLOCK=y
CONFIG_BLK_DEV_SD=y
CONFIG_EXT4_FS=y
# WSL mounts its modules VHD through OverlayFS before modules are available.
CONFIG_OVERLAY_FS=y
CONFIG_NET_9P=y
CONFIG_NET_9P_FD=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_LIBNVDIMM=y
CONFIG_VIRTIO_PMEM=y
CONFIG_VIRTIO_FS=y
CONFIG_PCI_HYPERV=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_MODULES=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_GENERIC_CPU=y
CONFIG_X86_64_VERSION=3
CONFIG_LTO_CLANG_THIN=y
CONFIG_FORTIFY_SOURCE=y
# CONFIG_X86_NATIVE_CPU is not set
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_LOCALVERSION=""
# Built-ins required before the custom module VHDX can be relied upon.
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_NET=y
CONFIG_HYPERV_KEYBOARD=y
