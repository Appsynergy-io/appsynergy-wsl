#!/usr/bin/env python3
"""Reject a requested WSL delta that Kconfig discarded or weakened."""
import sys
import json
from pathlib import Path

actual = set(Path(sys.argv[1]).read_text().splitlines())
missing = []
for line in Path(sys.argv[2]).read_text().splitlines():
    if line.startswith("CONFIG_") or (line.startswith("# CONFIG_") and line.endswith(" is not set")):
        if line not in actual:
            missing.append(line)
if missing:
    raise SystemExit("Required WSL config did not survive olddefconfig: " + ", ".join(missing))
if len(sys.argv) == 4:
    contract = json.loads(Path(sys.argv[3]).read_text())
    checks = {}
    for group, symbols in contract['required_builtin'].items():
        for symbol in symbols:
            checks[symbol] = f'CONFIG_{symbol}=y' in actual
    for symbol in contract['required_loadable']:
        checks[symbol] = f'CONFIG_{symbol}=m' in actual
    for symbol, value in contract['required_values'].items():
        checks[symbol] = f'CONFIG_{symbol}={value}' in actual
    for symbol in contract['forbidden']:
        checks[symbol] = f'# CONFIG_{symbol} is not set' in actual
    failed = [key for key, passed in checks.items() if not passed]
    if failed:
        raise SystemExit('WSL2 compatibility contract failed: ' + ', '.join(failed))
    print(json.dumps({'schema': 1, 'configuration': 'PASS', 'checks': checks,
                      'windows_acceptance': 'NOT RUN', 'reference': contract['reference']}, indent=2))
else:
    print("Every WSL delta assertion survived olddefconfig")
