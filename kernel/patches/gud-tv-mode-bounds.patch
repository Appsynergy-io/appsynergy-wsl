Subject: [PATCH] drm/gud: express TV response and table bounds before scanning

Reject device-reported lengths beyond the allocation and explicitly bound
iteration by the pointer table capacity. The latter lets ThinLTO prove that
its unrolled loop cannot scan a seventeenth name in a sixteen-entry buffer.
Keep the upstream NUL-termination check and CONFIG_FORTIFY_SOURCE enabled.

AppSynergy WSL compatibility patch over signed stable 7.2.13.
SPDX-License-Identifier: GPL-2.0-only

--- a/drivers/gpu/drm/gud/gud_connector.c
+++ b/drivers/gpu/drm/gud/gud_connector.c
@@ -390,13 +390,13 @@
 			  connector->index, buf, buf_len);
 	if (ret < 0)
 		goto free;
-	if (!ret || ret % GUD_CONNECTOR_TV_MODE_NAME_LEN) {
+	if (!ret || ret > buf_len || ret % GUD_CONNECTOR_TV_MODE_NAME_LEN) {
 		ret = -EIO;
 		goto free;
 	}
 
 	num_modes = ret / GUD_CONNECTOR_TV_MODE_NAME_LEN;
-	for (i = 0; i < num_modes; i++) {
+	for (i = 0; i < num_modes && i < ARRAY_SIZE(modes); i++) {
 		char *mode = &buf[i * GUD_CONNECTOR_TV_MODE_NAME_LEN];
 
 		if (!memchr(mode, '\0', GUD_CONNECTOR_TV_MODE_NAME_LEN)) {
